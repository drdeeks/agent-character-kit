{
  "name": "@drdeeks/character-kit",
  "version": "1.9.0",
  "description": "Agent character enforcement. Host-neutral core plus OpenAI, Claude, and Hermes companions. Fail-closed. Not a security boundary.",
  "main": "node/src/index.js",
  "exports": {
    ".": "./node/src/index.js",
    "./protocol": "./packages/protocol/src/index.js",
    "./core": "./packages/core/src/index.js",
    "./companion": "./packages/companion/src/index.js",
    "./events": "./packages/events/src/index.js",
    "./cli": "./packages/cli/src/index.js",
    "./daemon": "./packages/daemon/src/index.js",
    "./hooks": "./node/src/hooks/character.js",
    "./config-schema": "./packages/config-schema/src/index.js",
    "./mcp-contract": "./packages/mcp-contract/src/index.js"
  },
  "bin": {
    "ack": "node/bin/ack.js",
    "character-kit": "node/bin/ack.js"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/chatgpt-ack-mcp",
    "plugins/openai",
    "plugins/claude",
    "plugins/hermes"
  ],
  "scripts": {
    "test": "node --test node/tests/*.test.js packages/core/src/policy/engine.test.js packages/protocol/src/envelope.test.js packages/config-schema/src/*.test.js packages/events/src/*.test.js packages/daemon/src/*.test.js apps/chatgpt-ack-mcp/src/*.test.js plugins/openai/src/plugin-manifest.test.js plugins/claude/plugin-manifest.test.js",
    "test:python": "python3 python/tests/python_parity_test.py && python3 python/tests/ack_monitor_multi_agent_test.py && python3 python/hermes_plugin/test_plugin.py",
    "start": "node node/bin/ack.js",
    "ack-install": "node node/bin/install.js",
    "postinstall": "node node/bin/postinstall.js",
    "preuninstall": "node node/bin/preuninstall.js"
  },
  "keywords": [
    "agent",
    "character",
    "agent-character",
    "enforcement",
    "hooks",
    "yaml",
    "claude",
    "openai",
    "hermes",
    "opencode"
  ],
  "author": "drdeeks",
  "license": "MIT",
  "dependencies": {
    "commander": "^11.1.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.3.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "VERSION",
    "install.sh",
    "node/bin/",
    "node/src/",
    "node/enforcer/",
    "node/examples/",
    "packages/",
    "apps/chatgpt-ack-mcp/",
    "plugins/",
    "python/agent_character_kit/",
    "python/hermes_plugin/",
    "python/pyproject.toml",
    "deploy/",
    "docs/protocol/",
    "docs/adapters/",
    "docs/refactor-plan.md",
    "docs/chatgpt-hosted.md",
    "docs/PRIVACY.md",
    "docs/SECURITY.md",
    "docs/TERMS.md",
    "GPT-INTEGRATION-SPEC.md",
    "README.md",
    "AGENTS.md",
    "CHANGELOG.md",
    "LICENSE",
    "!**/*.test.js",
    "!**/test_*.py",
    "!**/tests/**",
    "!**/__pycache__/**",
    "!**/*.pyc",
    "!**/*.pyo",
    "!**/*.audit.jsonl",
    "!node/examples/.agent/logs/**"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drdeeks/agent-character-kit.git"
  },
  "homepage": "https://github.com/drdeeks/agent-character-kit#readme",
  "bugs": {
    "url": "https://github.com/drdeeks/agent-character-kit/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/drdeeks"
  }
}
