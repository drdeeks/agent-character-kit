# Node dependencies - never publish
node_modules/

# Git
.git/
.gitignore

# Test/validation files
/tmp/
*.log
# Runtime audit logs -- must mirror .gitignore's rule, or a live dev
# session's real enforcement log (not example content) ships in the
# published package the moment it exists on disk at pack time. Found live,
# 2026-08-07: enforcer-audit.jsonl was gitignored but not npmignored.
enforcer-audit.jsonl
*.audit.jsonl

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Python cache - anywhere in the tree, any depth
**/__pycache__
**/__pycache__/**
**/*.pyc
**/*.pyo

# Environment files
.env
.env.local

# Egg info
*.egg-info/

# Tarballs
*.tgz
*.tar.gz
