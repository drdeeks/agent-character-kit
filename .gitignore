# ===== Dependencies =====
node_modules/
.pnp
.pnp.js
.yarn/

# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.pytype/
*.egg-info/
.eggs/
build/
dist/

# ===== Agent Character Kit runtime / generated =====
.agent/
enforcer-audit.jsonl
*.audit.jsonl
memory/daily/*.yaml
# Example workspaces ARE fixtures meant to ship (override the .agent/ ignore above):
!node/examples/.agent/
!python/example_workspace/.agent/
node/examples/.agent/logs/
python/example_workspace/.agent/logs/
memory/weekly/*.yaml
node/memory/daily/*.yaml
node/memory/weekly/*.yaml
knowledge/vectors/vectors.json

# ===== enterprise-blueprint runtime / generated =====
# blueprint.md is the source of truth; everything below is mechanically
# regenerated from it via generate_checklist.py, same convention as the
# Agent Character Kit runtime files above.
.blueprint/checklist.md
.blueprint/checklist-data.json
.blueprint/.blueprint-chain/
.blueprint/.chain/
.blueprint/.blueprint-lock.json

# ===== Node =====
node/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ===== Env / secrets =====
.env
.env.*
*.local
*.pem
*.key

# ===== Archives / backups =====
*.tar.gz
*.tgz
*.zip
*.bak

# ===== Editors / OS =====
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ===== Misc =====
.cache/
.tmp/
tmp/
.trash/

# ===== Coverage =====
coverage/
.nyc_output/
htmlcov/
.coverage
*.lcov

# ===== Runtime sockets / logs =====
*.sock
*.log
