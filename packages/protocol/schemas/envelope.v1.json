{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "character-kit://protocol/envelope/v1",
  "title": "Character Kit protocol envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "version", "type", "requestId", "context"],
  "properties": {
    "protocol": { "const": "character-kit" },
    "version": { "const": "1" },
    "type": { "type": "string", "minLength": 1 },
    "requestId": { "type": "string", "minLength": 1 },
    "context": { "type": "object" },
    "payload": true
  }
}
